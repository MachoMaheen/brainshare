{
  "name": "brainshare-foundation",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "brainshare-foundation",
      "workspaces": [
        "packages/*",
        "cli",
        "apps/viewer"
      ]
    },
    "apps/viewer": {
      "name": "@brainshare/viewer",
      "version": "0.1.0",
      "dependencies": {
        "@brainshare/markdown": "0.1.0"
      }
    },
    "cli": {
      "name": "@brainshare/cli",
      "version": "0.2.0",
      "dependencies": {
        "@brainshare/core": "0.1.0",
        "@brainshare/protocol": "0.1.0",
        "@brainshare/sdk": "0.1.0"
      },
      "bin": {
        "brainshare": "brainshare.mjs"
      }
    },
    "node_modules/@brainshare/cli": {"resolved":"cli","link":true},
    "node_modules/@brainshare/core": {"resolved":"packages/core","link":true},
    "node_modules/@brainshare/markdown": {"resolved":"packages/markdown","link":true},
    "node_modules/@brainshare/protocol": {"resolved":"packages/protocol","link":true},
    "node_modules/@brainshare/sdk": {"resolved":"packages/sdk","link":true},
    "node_modules/@brainshare/viewer": {"resolved":"apps/viewer","link":true},
    "packages/core": {"name":"@brainshare/core","version":"0.1.0","dependencies":{"@brainshare/markdown":"0.1.0","@brainshare/protocol":"0.1.0"}},
    "packages/markdown": {"name":"@brainshare/markdown","version":"0.1.0"},
    "packages/protocol": {"name":"@brainshare/protocol","version":"0.1.0"},
    "packages/sdk": {"name":"@brainshare/sdk","version":"0.1.0","dependencies":{"@brainshare/protocol":"0.1.0"}}
  }
}
